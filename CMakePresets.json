{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "chomp-gcc-x86-native-bench",
      "displayName": "GCC x86 Native Benchmarking",
      "description": "Speed-optimized benchmark build for native x86 architecture compiled with GCC.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/chomp-gcc-x86-native-bench",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-std=c++20 -march=native -mtune=native -O3",
        "CATCH2_BENCH": "ON",
        "CATCH2_TEST": "OFF"
      },
      "environment": {
        "CXX": "/usr/bin/g++"
      }
    },
    {
      "name": "chomp-gcc-x86-native-profile",
      "displayName": "GCC x86 Native Benchmarking with Debug Symbols",
      "description": "Speed-optimized build with debug symbols for native x86 architecture compiled with GCC.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/chomp-gcc-x86-native-profile",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-std=c++20 -march=native -mtune=native -O3 -pg",
        "CATCH2_BENCH": "ON",
        "CATCH2_TEST": "OFF"
      },
      "environment": {
        "CXX": "/usr/bin/g++"
      }
    },
    {
      "name": "chomp-gcc-distribution-bench",
      "displayName": "GCC Benchmarking",
      "description": "Speed-optimized benchmark build for distribution compiled with GCC.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/chomp-gcc-distribution-bench",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-std=c++20 -O3",
        "CATCH2_BENCH": "ON",
        "CATCH2_TEST": "OFF"
      },
      "environment": {
        "CXX": "/usr/bin/g++"
      }
    },
    {
      "name": "chomp-gcc-debug",
      "displayName": "GCC Debug",
      "description": "Debug build compiled with GCC.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/chomp-gcc-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-std=c++20 -g -Wall -Wextra -O0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CATCH2_BENCH": "OFF",
        "CATCH2_TEST": "ON"
      },
      "environment": {
        "CXX": "/usr/bin/g++"
      },
      "warnings": {
        "dev": true,
        "deprecated": true,
        "unusedCli": true,
        "systemVars": true
      },
      "errors": {
        "dev": true,
        "deprecated": true
      }
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "Default Catch2 Testing",
      "configurePreset": "chomp-gcc-debug",
      "output": {
        "shortProgress": true,
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}